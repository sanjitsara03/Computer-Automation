{
  "schema_version": 1,
  "name": "open_new_account",
  "version": 2,
  "goal": "Log into ParaBank, open a new {account_type} account funded from account {funding_account_id}, and report the new account number.",
  "surface": {
    "kind": "web",
    "entry_path": "/parabank/index.htm"
  },
  "params": {
    "account_type": {
      "type": "str"
    },
    "funding_account_id": {
      "type": "str"
    },
    "username": {
      "type": "str",
      "secret": true
    },
    "password": {
      "type": "str",
      "secret": true
    }
  },
  "outputs": {
    "new_account_id": {
      "type": "str",
      "pattern": "^\\d+$"
    }
  },
  "steps": [
    {
      "id": "s1",
      "action": "type",
      "target": {
        "primary_null_reason": "empty_name",
        "fallback": {
          "css": "input[name='username']",
          "kind": "attribute"
        },
        "last": {
          "point": [
            358,
            314
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "Username"
        }
      },
      "value": {
        "secret": "username"
      },
      "checkpoint": {
        "kind": "value_matches"
      }
    },
    {
      "id": "s2",
      "action": "type",
      "target": {
        "primary_null_reason": "empty_name",
        "fallback": {
          "css": "input[name='password']",
          "kind": "attribute"
        },
        "last": {
          "point": [
            358,
            362
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "Password"
        }
      },
      "value": {
        "secret": "password"
      },
      "checkpoint": {
        "kind": "value_matches"
      }
    },
    {
      "id": "s3",
      "action": "click",
      "target": {
        "primary": {
          "role": "button",
          "name": "Log In"
        },
        "fallback": {
          "css": "input[value='Log In']",
          "kind": "attribute"
        },
        "last": {
          "point": [
            318,
            391
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "Log In"
        }
      },
      "checkpoint": {
        "kind": "role_visible",
        "role": "heading",
        "name": "Account Services"
      },
      "on_fail": [
        {"pattern": "could not be verified", "outcome": "login_failed"}
      ]
    },
    {
      "id": "s4",
      "action": "click",
      "target": {
        "primary": {
          "role": "link",
          "name": "Open New Account"
        },
        "fallback": {
          "css": "a[href*='openaccount.htm']",
          "kind": "attribute"
        },
        "last": {
          "point": [
            367,
            316
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "Open New Account"
        }
      },
      "checkpoint": {
        "kind": "role_visible",
        "role": "heading",
        "name": "Open New Account"
      }
    },
    {
      "id": "s5",
      "action": "select",
      "target": {
        "primary_null_reason": "empty_name",
        "fallback": {
          "css": "#type",
          "kind": "attribute"
        },
        "last": {
          "point": [
            558,
            353
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "What type of Account would you like to open?"
        }
      },
      "value": {
        "param": "account_type"
      },
      "checkpoint": {
        "kind": "value_matches"
      }
    },
    {
      "id": "s6",
      "action": "select",
      "target": {
        "primary_null_reason": "empty_name",
        "fallback": {
          "css": "#fromAccountId",
          "kind": "attribute"
        },
        "last": {
          "point": [
            558,
            439
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "A minimum of $100.00 must be deposited into this account at time of opening. Please choose an existing account to transfer funds into the new account."
        }
      },
      "value": {
        "param": "funding_account_id"
      },
      "checkpoint": {
        "kind": "value_matches"
      }
    },
    {
      "id": "s7",
      "action": "click",
      "target": {
        "primary": {
          "role": "button",
          "name": "Open New Account"
        },
        "fallback": {
          "css": "input[value='Open New Account']",
          "kind": "attribute"
        },
        "last": {
          "point": [
            557,
            477
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "Open New Account"
        }
      },
      "checkpoint": {
        "kind": "role_visible",
        "role": "heading",
        "name": "Account Opened!"
      },
      "risk": "irreversible"
    },
    {
      "id": "s8",
      "action": "extract",
      "target": {
        "primary_null_reason": "volatile_name",
        "fallback": {
          "css": "#newAccountId",
          "kind": "attribute"
        },
        "last": {
          "point": [
            676,
            352
          ],
          "viewport": [
            1280,
            720
          ],
          "anchor_text": "Your new account number:"
        }
      },
      "output": "new_account_id",
      "parse": {
        "pattern": "\\d+"
      },
      "checkpoint": {
        "kind": "text_matches",
        "pattern": "Your\\ new\\ account\\ number:\\s*\\d+"
      }
    }
  ]
}